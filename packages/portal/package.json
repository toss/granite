{
  "name": "@granite-js/portal",
  "version": "1.0.38",
  "description": "Attach React Native portals to Activity- and UIViewController-owned hosts",
  "main": "./dist/module/index.js",
  "types": "./dist/typescript/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "android",
    "ios",
    "common",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "prepack": "yarn build",
    "test": "jest --coverage ./src",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src babel.config.js react-native.config.js",
    "build": "bob build && tsc --project tsconfig.build.json"
  },
  "keywords": [
    "react-native",
    "portal",
    "teleport",
    "reparent",
    "ios",
    "android",
    "web"
  ],
  "author": "Granite Contributors",
  "homepage": "https://granite.run",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@react-native/babel-preset": "catalog:react-native",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "catalog:react-native",
    "@types/react-dom": "catalog:react-native",
    "babel-jest": "^29.7.0",
    "eslint": "^9.7.0",
    "jest": "^29.7.0",
    "react": "catalog:react-native",
    "react-dom": "catalog:react-native",
    "react-native": "catalog:react-native",
    "react-native-builder-bob": "catalog:tools",
    "react-test-renderer": "19.2.3",
    "typescript": "catalog:tools"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "TeleportViewSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.teleport"
    },
    "ios": {
      "componentProvider": {
        "PortalView": "PortalView",
        "PortalHostView": "PortalHostView"
      }
    }
  },
  "sideEffects": false
}
