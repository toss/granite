{
  "name": "@granite-js/rollipop",
  "version": "3.0.0",
  "type": "module",
  "description": "Rollipop bundler adapter for Granite",
  "license": "Apache-2.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "yarn build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@granite-js/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:tools",
    "rollipop": "catalog:rollipop",
    "tsdown": "catalog:tools",
    "typescript": "catalog:tools",
    "vitest": "^4.0.12"
  },
  "peerDependencies": {
    "rollipop": "^1"
  },
  "sideEffects": false
}
